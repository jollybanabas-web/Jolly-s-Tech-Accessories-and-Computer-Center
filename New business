                description: "Reliable solar power system to power lights, TVs, computers, and phone charging during power outages."
            }
        ];

        // Global State
        let cart = [];
        let currentDiscountRate = 0;

        // On Load Initializer
        document.addEventListener("DOMContentLoaded", () => {
            renderProducts(products);
            updateCartUI();
        });

        // Helper: Format UGX
        function formatUGX(amount) {
            return "UGX " + amount.toLocaleString('en-US');
        }

        // Render Product Cards
        function renderProducts(items) {
            const grid = document.getElementById("productsGrid");
            grid.innerHTML = "";

            if (items.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400">
                        <i class="fa-solid fa-box-open text-4xl mb-3"></i>
                        <p class="text-sm font-semibold">No electronics found matching your search.</p>
                    </div>
                `;
                return;
            }

            items.forEach(product => {
                const card = document.createElement("div");
                card.className = "bg-slate-800/80 border border-slate-700 rounded-2xl overflow-hidden hover:border-jolly-cyan transition-all duration-300 flex flex-col justify-between group";
                card.innerHTML = `
                    <div class="relative overflow-hidden bg-slate-900">
                        <span class="absolute top-3 left-3 z-10 bg-jolly-navy/90 text-jolly-cyan text-[10px] font-bold px-2.5 py-1 rounded-full uppercase border border-jolly-cyan/30">${product.tag}</span>
                        <img src="${product.image}" alt="${product.name}" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <button onclick="openQuickView(${product.id})" class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-semibold gap-1">
                            <i class="fa-solid fa-eye"></i> Quick View
                        </button>
                    </div>

                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <span class="text-[10px] font-bold uppercase text-amber-400 tracking-wider">${product.category}</span>
                            <h3 class="font-bold text-white text-xs mt-1 line-clamp-2 hover:text-jolly-cyan transition-colors cursor-pointer" onclick="openQuickView(${product.id})">${product.name}</h3>
                            <div class="flex items-center gap-1.5 mt-2 text-xs text-amber-400">
                                <i class="fa-solid fa-star"></i>
                                <span class="font-bold text-white text-xs">${product.rating}</span>
                                <span class="text-slate-400 text-[10px]">(${product.reviews})</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-700/80 flex items-center justify-between">
                            <div>
                                <span class="text-slate-400 text-[10px] block">Price</span>
                                <span class="text-sm font-extrabold text-jolly-cyan">${formatUGX(product.price)}</span>
                            </div>
                            <button onclick="addToCart(${product.id})" class="bg-jolly-cyan hover:bg-cyan-400 text-jolly-navy text-xs font-bold px-3 py-2 rounded-xl transition-colors flex items-center gap-1">
                                <i class="fa-solid fa-cart-plus"></i> Add
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Category Filter
        function filterCategory(category) {
            document.querySelectorAll(".cat-btn").forEach(btn => {
                if (btn.dataset.category === category) {
                    btn.className = "cat-btn bg-jolly-cyan text-jolly-navy text-xs font-bold px-4 py-2 rounded-full whitespace-nowrap shadow-sm transition-colors";
                } else {
                    btn.className = "cat-btn bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold px-4 py-2 rounded-full whitespace-nowrap transition-colors";
                }
            });

            if (category === 'All') {
                renderProducts(products);
            } else {
                renderProducts(products.filter(p => p.category === category));
            }
        }

        // Search Filter
        function handleSearch(query) {
            const q = query.toLowerCase().trim();
            const filtered = products.filter(p => 
                p.name.toLowerCase().includes(q) || 
                p.category.toLowerCase().includes(q) ||
                p.description.toLowerCase().includes(q)
            );
            renderProducts(filtered);
        }

        // Add to Cart
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            const existing = cart.find(item => item.id === productId);

            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            showToast(`Added to cart: ${product.name.slice(0, 18)}...`);
        }

        // Update Cart UI
        function updateCartUI() {
            const container = document.getElementById("cartItemsContainer");
            const badge = document.getElementById("cartBadgeCount");
            const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);

            badge.innerText = totalItems;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="py-16 text-center text-slate-400">
                        <i class="fa-solid fa-cart-flatbed text-4xl mb-3"></i>
                        <p class="text-xs font-medium">Your cart is empty.</p>
                        <a href="#store" onclick="toggleCartDrawer()" class="inline-block mt-3 text-xs font-bold text-jolly-cyan hover:underline">Explore Electronics</a>
                    </div>
                `;
            } else {
                container.innerHTML = "";
                cart.forEach(item => {
                    const el = document.createElement("div");
                    el.className = "flex items-center gap-3 p-3 bg-slate-800 rounded-xl border border-slate-700";
                    el.innerHTML = `
                        <img src="${item.image}" class="w-12 h-12 object-cover rounded-lg">
                        <div class="flex-1">
                            <h4 class="text-xs font-bold text-white line-clamp-1">${item.name}</h4>
                            <span class="text-xs font-semibold text-jolly-cyan">${formatUGX(item.price * item.quantity)}</span>
                            <div class="flex items-center gap-2 mt-1">
                                <button onclick="changeQty(${item.id}, -1)" class="w-5 h-5 bg-slate-700 border rounded text-xs flex items-center justify-center font-bold">-</button>
                                <span class="text-xs font-bold">${item.quantity}</span>
                                <button onclick="changeQty(${item.id}, 1)" class="w-5 h-5 bg-slate-700 border rounded text-xs flex items-center justify-center font-bold">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-slate-400 hover:text-red-400 text-sm">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    `;
                    container.appendChild(el);
                });
            }

            const subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
            const discountAmt = subtotal * currentDiscountRate;
            const finalTotal = subtotal - discountAmt;

            document.getElementById("cartSubtotal").innerText = formatUGX(subtotal);
            document.getElementById("cartDiscount").innerText = "-" + formatUGX(discountAmt);
            document.getElementById("cartTotal").innerText = formatUGX(finalTotal);
            document.getElementById("checkoutTotalAmount").innerText = formatUGX(finalTotal);
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (!item) return;

            item.quantity += delta;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.id !== id);
            }
            updateCartUI();
        }

        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartUI();
            showToast("Item removed from cart");
        }

        function applyPromo() {
            const code = document.getElementById("promoCodeInput").value.trim().toUpperCase();
            if (code === 'KYOTERA10') {
                currentDiscountRate = 0.10;
                showToast("10% Kyotera Promo Applied!");
            } else {
                showToast("Invalid code. Use KYOTERA10", "error");
            }
            updateCartUI();
        }

        function toggleCartDrawer() {
            document.getElementById("cartDrawer").classList.toggle("hidden");
        }

        function toggleMobileMenu() {
            document.getElementById("mobileMenu").classList.toggle("hidden");
        }

        // Live Banner Preview Builder
        function updateAdPreview() {
            const name = document.getElementById("adBizName").value.trim() || "Your Business Name";
            const text = document.getElementById("adText").value.trim() || "Your advertisement offer text will display here live...";
            
            document.getElementById("prevBiz").innerText = name;
            document.getElementById("prevText").innerText = text;
        }

        function openQuickView(id) {
            const product = products.find(p => p.id === id);
            const modal = document.getElementById("quickViewModal");
            const content = document.getElementById("quickViewContent");

            content.innerHTML = `
                <button onclick="closeQuickView()" class="absolute top-4 right-4 text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                    <img src="${product.image}" class="w-full h-60 object-cover rounded-2xl border border-slate-700">
                    <div class="space-y-4">
                        <span class="bg-amber-400/20 text-amber-300 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">${product.category}</span>
                        <h3 class="text-lg font-bold text-white">${product.name}</h3>
                        <p class="text-xs text-slate-300 leading-relaxed">${product.description}</p>
                        <div class="text-xl font-extrabold text-jolly-cyan">${formatUGX(product.price)}</div>
                        <div class="pt-2 flex gap-3">
                            <button onclick="addToCart(${product.id}); closeQuickView();" class="flex-1 bg-jolly-cyan hover:bg-cyan-400 text-jolly-navy font-bold py-3 rounded-xl text-xs transition-colors">
                                Add To Cart
                            </button>
                            <a href="https://wa.link/v839xq?text=I'm%20interested%20in%20${encodeURIComponent(product.name)}" target="_blank" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-3 rounded-xl text-xs flex items-center justify-center">
                                <i class="fa-brands fa-whatsapp text-lg"></i>
                            </a>
                        </div>
                    </div>
                </div>
            `;
            modal.classList.remove("hidden");
        }

        function closeQuickView() {
            document.getElementById("quickViewModal").classList.add("hidden");
        }

        function openCheckoutModal() {
            if (cart.length === 0) {
                showToast("Your cart is empty!", "error");
                return;
            }
            toggleCartDrawer();
            document.getElementById("checkoutModal").classList.remove("hidden");
        }

        function closeCheckoutModal() {
            document.getElementById("checkoutModal").classList.add("hidden");
        }

        function handleCheckoutSubmit(e) {
            e.preventDefault();
            const name = document.getElementById("custName").value;
            const phone = document.getElementById("custPhone").value;
            const address = document.getElementById("custAddress").value;
            const payMethod = document.querySelector('input[name="payMethod"]:checked').value;

            closeCheckoutModal();

            let summary = `*NEW ORDER - JOLLY'S TECH KYOTERA*\n`;
            summary += `Customer: ${name}\nPhone: ${phone}\nLocation: ${address}\nPayment Option: ${payMethod}\n\n*Ordered Electronics:*\n`;
            cart.forEach(i => {
                summary += `- ${i.name} x${i.quantity} (${formatUGX(i.price * i.quantity)})\n`;
            });
            summary += `\n*Total Payable:* ${document.getElementById("cartTotal").innerText}`;

            showToast("Opening WhatsApp to place your order...");
            setTimeout(() => {
                window.open(`https://wa.link/v839xq?text=${encodeURIComponent(summary)}`, '_blank');
                cart = [];
                updateCartUI();
            }, 1000);
        }

        function handleAdSubmit(e) {
            e.preventDefault();
            const biz = document.getElementById("adBizName").value;
            const contact = document.getElementById("adContact").value;
            const tier = document.getElementById("adTier").value;
            const loc = document.getElementById("adLocation").value;
            const text = document.getElementById("adText").value;

            const msg = `*NEW BUSINESS AD REQUEST (KYOTERA)*\nBusiness: ${biz}\nContact: ${contact}\nLocation: ${loc}\nAd Tier: ${tier}\nTagline: ${text}`;
            
            showToast("Opening WhatsApp for Ad Approval...");
            setTimeout(() => {
                window.open(`https://wa.link/v839xq?text=${encodeURIComponent(msg)}`, '_blank');
                document.getElementById("adSubmissionForm").reset();
            }, 1000);
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById("toast");
            const toastMsg = document.getElementById("toastMsg");
            const toastIcon = document.getElementById("toastIcon");

            toastMsg.innerText = msg;
            if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-exclamation text-red-400";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-jolly-cyan";
            }

            toast.classList.remove("translate-y-20", "opacity-0");
            toast.classList.add("translate-y-0", "opacity-100");

            setTimeout(() => {
                toast.classList.remove("translate-y-0", "opacity-100");
                toast.classList.add("translate-y-20", "opacity-0");
            }, 3000);
        }
    </script>
